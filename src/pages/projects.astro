---
import PageLayout from '@/layouts/PageLayout.astro';
import AnimatedReveal from '@/components/AnimatedReveal.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Photo from '@/components/Photo.astro';
import { getPublishedProjects } from '@/lib/content';
import { photos } from '@/data/photos';
import { projectsIntro, projectFramework } from '@/data/projects';

const projects = await getPublishedProjects();
const description =
  'Project experience at Transform Energy Consultancy: multidisciplinary engineering and power-sector expertise applied to project requirements. Named case studies are published when they are supplied.';
---

<PageLayout
  title="Project Experience"
  description={description}
  path="/projects"
  ogTitle="Project Experience"
  ogDescription={description}
  eyebrow={projectsIntro.eyebrow}
  heading={projectsIntro.heading}
  lede={projectsIntro.lede}
  crumbs={[{ href: '/', label: 'Home' }, { label: 'Projects' }]}
  ctaTitle="Discuss a project requirement."
  ctaBody="Write with a short note on the engineering, regulatory, or project-support assignment."
>
  <section class="mx-auto shell px-6 py-16 sm:px-8 lg:py-20">
    <AnimatedReveal>
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16">
        <div>
          <SectionHeading
            eyebrow="The framework"
            title="Experience applied to the assignment."
            kicker={projectsIntro.body}
          />
        </div>
        <Photo
          src={photos.offshore}
          alt=""
          class="overflow-hidden border border-line"
          imgClass="h-64 w-full object-cover sm:h-72"
          sizes="(min-width: 1024px) 480px, 100vw"
        />
      </div>
    </AnimatedReveal>

    {
      projects.length > 0 ? (
        <ul class="mt-14 grid gap-4 md:grid-cols-2">
          {projects.map((project) => (
            <li>
              <ProjectCard entry={project} />
            </li>
          ))}
        </ul>
      ) : (
        <div class="mt-14">
          <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-mute">
            Capability domains
          </h2>
          <ul class="mt-6 grid gap-px border border-line bg-line sm:grid-cols-2">
            {projectFramework.map((item, index) => (
              <li class="bg-white p-6 sm:p-8">
                <AnimatedReveal>
                  <p class="font-mono text-[0.65rem] tracking-[0.18em] text-mute">
                    {String(index + 1).padStart(2, '0')}
                  </p>
                  <h3 class="mt-3 text-lg font-semibold text-navy">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-mute">{item.body}</p>
                </AnimatedReveal>
              </li>
            ))}
          </ul>
          <p class="mt-8 max-w-2xl text-sm leading-relaxed text-mute">
            Specific assignments can be discussed directly.
            <a href="/contact" class="font-semibold text-navy hover:underline"> Contact the practice</a>.
          </p>
        </div>
      )
    }
  </section>
</PageLayout>
