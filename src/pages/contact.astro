---
import PageLayout from '@/layouts/PageLayout.astro';
import Logo from '@/components/Logo.astro';
import AnimatedReveal from '@/components/AnimatedReveal.astro';
import ContactDetails from '@/components/ContactDetails.astro';
import { services } from '@/data/services';
import { contact } from '@/data/company';
---

<PageLayout
  title="Contact"
  description="Contact Transform Energy Consultancy at Dotspace Business Centre, Punkunnam, Thrissur, or email tecskaaa@gmail.com."
  path="/contact"
  ogTitle="Contact Transform Energy Consultancy"
  ogDescription="Contact Transform Energy Consultancy at Dotspace Business Centre, Punkunnam, Thrissur, or email tecskaaa@gmail.com."
  eyebrow="Contact"
  heading="Get in touch."
  lede="Visit the Thrissur office, write to us, or send a short note on the work you need."
  crumbs={[{ href: '/', label: 'Home' }, { label: 'Contact' }]}
  showCta={false}
>
  <section class="mx-auto grid shell gap-12 px-6 py-16 sm:px-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <AnimatedReveal>
      <div class="border border-line bg-canvas p-6 sm:p-8">
        <div class="mb-8 flex justify-start border border-line bg-white p-4">
          <Logo size="contact" linked={false} />
        </div>
        <ContactDetails />
        <iframe
          title="Transform Energy Consultancy office, Punkunnam, Thrissur"
          src={contact.mapsEmbed}
          class="mt-8 h-56 w-full border border-line"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </AnimatedReveal>
    <AnimatedReveal>
      <h2 class="text-xl font-semibold text-navy">Send a message</h2>
      <p class="mt-2 text-sm text-mute">
        Or email <a href={`mailto:${contact.email}`} class="font-medium text-navy hover:underline">{contact.email}</a> directly.
      </p>
      <form
        class="mt-8 space-y-5"
        method="POST"
        action="/api/contact"
        data-contact-form
        novalidate
      >
        <p class="hidden">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
        </p>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium text-navy">
            Name
            <input
              required
              name="name"
              autocomplete="name"
              class="mt-2 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-ink outline-none focus:border-navy"
            />
          </label>
          <label class="block text-sm font-medium text-navy">
            Organisation
            <input
              name="organisation"
              autocomplete="organization"
              class="mt-2 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-ink outline-none focus:border-navy"
            />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium text-navy">
            Email
            <input
              required
              type="email"
              name="email"
              autocomplete="email"
              class="mt-2 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-ink outline-none focus:border-navy"
            />
          </label>
          <label class="block text-sm font-medium text-navy">
            Telephone
            <input
              type="tel"
              name="telephone"
              autocomplete="tel"
              class="mt-2 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-ink outline-none focus:border-navy"
            />
          </label>
        </div>
        <label class="block text-sm font-medium text-navy">
          Service of interest
          <select
            name="service"
            class="mt-2 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-ink outline-none focus:border-navy"
          >
            <option value="">Select if relevant</option>
            {services.map((service) => <option value={service.slug}>{service.title}</option>)}
          </select>
        </label>
        <label class="block text-sm font-medium text-navy">
          Message
          <textarea
            required
            name="message"
            rows="6"
            class="mt-2 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-ink outline-none focus:border-navy"
          ></textarea>
        </label>
        <p data-form-status class="hidden text-sm" role="status"></p>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-sm bg-navy px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-navy-dark"
        >
          Send message
        </button>
      </form>
    </AnimatedReveal>
  </section>
</PageLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.classList.remove('hidden', 'text-energy', 'text-red-700');
      status.textContent = 'Sending…';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const payload = (await response.json()) as { ok?: boolean; message?: string };
        if (!response.ok || !payload.ok) {
          throw new Error(payload.message || 'The message could not be sent.');
        }
        status.classList.add('text-energy');
        status.textContent = payload.message ?? 'Thank you. We have received your message.';
        form.reset();
      } catch (error) {
        status.classList.add('text-red-700');
        status.textContent =
          error instanceof Error ? error.message : 'The message could not be sent. Please email us instead.';
      }
    });
  }
</script>
