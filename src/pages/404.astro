---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout
  title="Page not found"
  description="The requested page is not available on the Transform Energy Consultancy website."
  path="/404"
  noindex
  jsonLd={false}
>
  <section class="mx-auto max-w-3xl px-6 py-24 text-center sm:px-8">
    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">404</p>
    <h1 class="mt-4 text-4xl font-semibold text-navy">This page is not available.</h1>
    <p class="mt-4 text-mute">The page may have moved, or the link is out of date.</p>
    <div class="mt-8 flex justify-center gap-3">
      <Button href="/" variant="primary">Home</Button>
      <Button href="/contact" variant="secondary">Contact</Button>
    </div>
  </section>
</BaseLayout>
