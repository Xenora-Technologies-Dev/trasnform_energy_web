---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Experience from '@/components/home/Experience.astro';
import LeadershipPreview from '@/components/home/LeadershipPreview.astro';
import AboutPreview from '@/components/home/AboutPreview.astro';
import ExpertiseEcosystem from '@/components/home/ExpertiseEcosystem.astro';
import HomeServices from '@/components/home/HomeServices.astro';
import WhyTransform from '@/components/home/WhyTransform.astro';
import CtaSection from '@/components/CtaSection.astro';
---

<BaseLayout path="/">
  <Hero />
  <Experience />
  <LeadershipPreview />
  <AboutPreview />
  <ExpertiseEcosystem />
  <HomeServices />
  <WhyTransform />
  <CtaSection
    id="enquire"
    title="Have an energy or power-sector requirement?"
    body="Discuss engineering, regulatory, renewable-energy, project, or technical documentation needs with Transform Energy. Write with a short note on the assignment."
    ctaLabel="Talk to Transform Energy"
    ctaHref="/contact"
  />
</BaseLayout>
