---
import PageLayout from '@/layouts/PageLayout.astro';
import AnimatedReveal from '@/components/AnimatedReveal.astro';
import FeaturedInsight from '@/components/insights/FeaturedInsight.astro';
import InsightCard from '@/components/insights/InsightCard.astro';
import InsightFilters from '@/components/insights/InsightFilters.astro';
import { insightsIntro } from '@/data/insights';
import { ENERGY_NEWS_CONFIG } from '@/data/energy-news-config';
import { company } from '@/data/company';
import { getPublishedInsights, featuredInsight, sortInsights, getIndexableTopics } from '@/lib/insights';
import { absoluteUrl } from '@/data/seo';

const insights = sortInsights(await getPublishedInsights());
const featured = featuredInsight(insights);
const rest = insights.filter((entry) => entry.id !== featured?.id);
const topics = getIndexableTopics(insights);
const description = ENERGY_NEWS_CONFIG.listingSupport;
const origin = Astro.site;
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Energy Intelligence',
  description,
  url: origin ? absoluteUrl('/insights', origin) : '/insights',
  publisher: { '@type': 'Organization', name: company.publicName },
};
---

<PageLayout
  title="Energy Intelligence"
  description={description}
  path="/insights"
  ogTitle="Energy Intelligence"
  ogDescription={description}
  image="/og/insights-default.svg"
  imageAlt={`${company.publicName} Energy Intelligence`}
  imageWidth={1200}
  imageHeight={630}
  eyebrow={insightsIntro.eyebrow}
  heading={insightsIntro.heading}
  lede={`${insightsIntro.lede} ${insightsIntro.support}`}
  crumbs={[{ href: '/', label: 'Home' }, { label: 'Insights' }]}
  ctaTitle="Need expert guidance on an energy-sector requirement?"
  ctaBody="Write with a short note on the regulatory, market, or project-documentation question."
  ctaLabel="Talk to Transform Energy"
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(collectionLd)} />

  <section class="mx-auto shell px-6 py-16 sm:px-8 lg:py-20">
    {
      insights.length === 0 ? (
        <AnimatedReveal>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">
            {insightsIntro.emptyTitle}
          </p>
          <h2 class="mt-3 text-2xl font-semibold text-navy sm:text-3xl">A place for energy-sector intelligence.</h2>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-mute">{insightsIntro.emptyBody}</p>
        </AnimatedReveal>
      ) : (
        <div class="space-y-12">
          {featured && (
            <AnimatedReveal>
              <FeaturedInsight entry={featured} />
            </AnimatedReveal>
          )}

          <div>
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">Latest developments</p>
            <h2 class="mt-3 text-2xl font-semibold text-navy sm:text-3xl">Recent briefings</h2>
            <div class="mt-8">
              <InsightFilters />
            </div>
            {
              topics.length > 0 && (
                <ul class="mt-6 flex flex-wrap gap-2">
                  {topics.map((topic) => (
                    <li>
                      <a
                        href={`/insights/${topic.id}`}
                        class="border border-line px-3 py-1.5 text-xs font-semibold tracking-wide text-navy hover:border-navy/40"
                      >
                        {topic.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
            <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              {rest.map((entry) => (
                <InsightCard entry={entry} />
              ))}
            </div>
          </div>
        </div>
      )
    }
  </section>
</PageLayout>
