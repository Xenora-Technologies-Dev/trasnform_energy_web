---
import type { CollectionEntry } from 'astro:content';

type Props = {
  entry: CollectionEntry<'projects'>;
};

const { entry } = Astro.props;
const meta = [entry.data.sector, entry.data.location, entry.data.year].filter(Boolean);
---

<article class="border border-line bg-white p-6 sm:p-8">
  {
    meta.length > 0 && (
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-mute">{meta.join(' · ')}</p>
    )
  }
  <h3 class="mt-3 text-xl font-semibold text-navy">{entry.data.title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-mute">{entry.data.summary}</p>
</article>
