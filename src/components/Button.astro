---
type Props = {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'on-dark' | 'outline-on-dark';
  type?: 'button' | 'submit';
  class?: string;
};

const {
  href,
  variant = 'primary',
  type = 'button',
  class: className = '',
} = Astro.props;

const classes = {
  primary:
    'bg-navy text-white hover:bg-navy-dark border border-navy',
  secondary:
    'bg-white text-navy border border-navy hover:bg-canvas',
  ghost:
    'bg-transparent text-navy border border-transparent hover:border-line',
  'on-dark':
    'bg-white text-navy border border-white hover:bg-canvas',
  'outline-on-dark':
    'bg-transparent text-white border border-white/80 hover:bg-white/10',
} as const;

const shared =
  'inline-flex items-center justify-center gap-2 rounded-sm px-5 py-2.5 text-sm font-semibold tracking-wide transition-colors duration-200';
---

{
  href ? (
    <a href={href} class:list={[shared, classes[variant], className]}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[shared, classes[variant], className]}>
      <slot />
    </button>
  )
}
