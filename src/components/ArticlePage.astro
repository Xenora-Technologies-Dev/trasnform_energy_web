---
import InsightArticle from '@/components/insights/InsightArticle.astro';
import { getPublishedInsights, relatedInsights, type InsightEntry } from '@/lib/insights';

type Props = {
  entry: InsightEntry;
};

const { entry } = Astro.props;
const related = relatedInsights(entry, await getPublishedInsights());
---

<InsightArticle entry={entry} related={related} />
