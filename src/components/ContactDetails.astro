---
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import WhatsAppIcon from '@/components/WhatsAppIcon.astro';
import { company, contact, office } from '@/data/company';

type Props = {
  tone?: 'light' | 'dark';
};

const { tone = 'light' } = Astro.props;
const isDark = tone === 'dark';
---

<div class="space-y-6">
  <div>
    <p class:list={['text-[0.7rem] font-semibold uppercase tracking-[0.2em]', isDark ? 'text-spark' : 'text-energy']}>
      Office
    </p>
    <p class:list={['mt-3 inline-flex items-start gap-2 text-sm leading-relaxed', isDark ? 'text-white/80' : 'text-ink']}>
      <MapPin class:list={['mt-0.5 h-4 w-4 shrink-0', isDark ? 'text-spark' : 'text-navy']} aria-hidden="true" />
      <a href={contact.mapsUrl} class="hover:underline" rel="noopener noreferrer" target="_blank">
        {office.lines.map((line) => (
          <span class="block">{line}</span>
        ))}
      </a>
    </p>
  </div>
  <div>
    <p class:list={['text-[0.7rem] font-semibold uppercase tracking-[0.2em]', isDark ? 'text-spark' : 'text-energy']}>
      Email
    </p>
    <p class="mt-3 inline-flex items-center gap-2 text-sm">
      <Mail class:list={['h-4 w-4 shrink-0', isDark ? 'text-spark' : 'text-navy']} aria-hidden="true" />
      <a
        href={`mailto:${contact.email}`}
        class:list={['font-medium hover:underline', isDark ? 'text-white' : 'text-navy']}
      >
        {contact.email}
      </a>
    </p>
  </div>
  <div>
    <p class:list={['text-[0.7rem] font-semibold uppercase tracking-[0.2em]', isDark ? 'text-spark' : 'text-energy']}>
      Telephone
    </p>
    <ul class="mt-3 space-y-2">
      {
        contact.phones.map((phone) => (
          <li>
            <a
              href={phone.href}
              class:list={[
                'inline-flex items-center gap-2 text-sm font-medium hover:underline',
                isDark ? 'text-white' : 'text-navy',
              ]}
            >
              <Phone class:list={['h-4 w-4 shrink-0', isDark ? 'text-spark' : 'text-navy']} aria-hidden="true" />
              {phone.display}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <p class:list={['text-[0.7rem] font-semibold uppercase tracking-[0.2em]', isDark ? 'text-spark' : 'text-energy']}>
      WhatsApp
    </p>
    <ul class="mt-3 space-y-3">
      {
        contact.whatsapp.map((entry) => (
          <li>
            <a
              href={entry.href}
              class:list={[
                'inline-flex items-center gap-2 text-sm font-semibold hover:underline',
                isDark ? 'text-white' : 'text-navy',
              ]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span
                class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#25D366] text-white"
                aria-hidden="true"
              >
                <WhatsAppIcon class="h-4 w-4" />
              </span>
              Chat on WhatsApp {entry.display}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class:list={['text-xs', isDark ? 'text-white/45' : 'text-mute']}>{company.legalName}</p>
</div>
