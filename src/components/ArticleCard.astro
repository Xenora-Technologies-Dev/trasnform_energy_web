---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import type { CollectionEntry } from 'astro:content';

type Props = {
  entry: CollectionEntry<'insights'>;
};

const { entry } = Astro.props;
const published = entry.data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="border-b border-line py-8 first:border-t">
  <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-mute">
    <time datetime={entry.data.pubDate.toISOString()}>{published}</time>
    {entry.data.topic && <span> · {entry.data.topic}</span>}
  </p>
  <h2 class="mt-3 text-2xl font-semibold tracking-tight text-navy">
    <a href={`/insights/${entry.id}`} class="hover:underline">
      {entry.data.title}
    </a>
  </h2>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mute sm:text-base">{entry.data.description}</p>
  <a
    href={`/insights/${entry.id}`}
    class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-navy"
  >
    Read article
    <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
  </a>
</article>
