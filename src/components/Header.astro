---
import Menu from '@lucide/astro/icons/menu';
import Logo from '@/components/Logo.astro';
import Navigation from '@/components/Navigation.astro';
import ServicesMegaMenu from '@/components/ServicesMegaMenu.astro';
import MobileNav from '@/components/MobileNav.astro';
import Button from '@/components/Button.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[80] focus:bg-white focus:px-4 focus:py-2 focus:text-navy"
>
  Skip to content
</a>

<header
  data-site-header
  class="site-header sticky top-0 z-50 border-b border-line bg-white py-3"
>
  <div class="mx-auto flex shell items-center justify-between gap-6 px-4 sm:px-6 lg:px-8 xl:px-12">
    <Logo size="header" />
    <div class="flex items-center gap-4">
      <Navigation currentPath={currentPath} />
      <Button href="/contact" variant="primary" class="hidden sm:inline-flex">
        Contact
      </Button>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center border border-line text-navy lg:hidden"
        data-mobile-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Menu class="h-5 w-5" />
      </button>
    </div>
  </div>
  <ServicesMegaMenu currentPath={currentPath} />
</header>

<MobileNav />

<script>
  import { initHeader } from '@/scripts/header';
  initHeader();
</script>
