---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  priority?: boolean;
  class?: string;
  imgClass?: string;
  sizes?: string;
};

const {
  src,
  alt,
  caption,
  priority = false,
  class: className = '',
  imgClass = 'h-full w-full object-cover',
  sizes = '(min-width: 1024px) 960px, 100vw',
} = Astro.props;
---

<figure class={className}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1800]}
    sizes={sizes}
    quality={80}
    class={imgClass}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
  />
  {
    caption && (
      <figcaption class="mt-3 text-sm text-mute">{caption}</figcaption>
    )
  }
</figure>
