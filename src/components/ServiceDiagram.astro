---
import type { ServiceDiagram } from '@/data/services';

type Props = {
  variant: ServiceDiagram;
  tone?: 'light' | 'dark';
  caption?: string;
  class?: string;
  idPrefix?: string;
};

const { variant, tone = 'light', caption, class: className = '', idPrefix = variant } = Astro.props;
const isDark = tone === 'dark';
const titles: Record<ServiceDiagram, string> = {
  grid: 'Illustrative power-infrastructure schematic',
  regulatory: 'Illustrative state and central regulatory layers',
  project: 'Illustrative project-supervision sequence',
  renewable: 'Illustrative renewable-energy flow',
  market: 'Illustrative operating sequence',
  docs: 'Illustrative documentation stack',
  audit: 'Illustrative safety-audit circuit',
};
const titleId = `diagram-title-${idPrefix}`;
const descId = `diagram-desc-${idPrefix}`;
---

<figure class:list={['relative overflow-hidden', className]}>
  <svg
    class="h-full w-full"
    viewBox="0 0 640 360"
    fill="none"
    role="img"
    aria-labelledby={`${titleId} ${descId}`}
  >
    <title id={titleId}>{titles[variant]}</title>
    <desc id={descId}>Abstract line illustration. Not a site drawing or operating data.</desc>

    {
      variant === 'grid' && (
        <g>
          <line x1="40" y1="300" x2="600" y2="300" stroke={isDark ? 'rgba(255,255,255,0.18)' : '#E5E9E7'} />
          <path
            d="M80 300 V140 H160 V300 M240 300 V90 H360 V300 M440 300 V150 H560 V300"
            stroke={isDark ? 'rgba(255,255,255,0.55)' : '#0B2A52'}
            stroke-width="1.5"
          />
          <path
            d="M80 140 L160 90 H240 L360 70 H440 L560 110"
            stroke="#3F9B2F"
            stroke-width="1.5"
          />
          <circle cx="160" cy="90" r="5" stroke="#F5B51B" />
          <circle cx="360" cy="70" r="5" stroke="#F5B51B" />
          <circle cx="560" cy="110" r="5" stroke="#F5B51B" />
          <g
            fill={isDark ? 'rgba(255,255,255,0.55)' : '#64717D'}
            font-size="11"
            font-family="ui-monospace, monospace"
            letter-spacing="0.12em"
          >
            <text x="80" y="328">BAY</text>
            <text x="260" y="328">BUS</text>
            <text x="480" y="328">LINE</text>
          </g>
        </g>
      )
    }

    {
      variant === 'regulatory' && (
        <g>
          <rect x="72" y="56" width="496" height="72" stroke={isDark ? 'rgba(255,255,255,0.45)' : '#0B2A52'} />
          <rect x="104" y="152" width="432" height="72" stroke="#3F9B2F" />
          <rect x="136" y="248" width="368" height="56" stroke="#F5B51B" />
          <g
            fill={isDark ? 'rgba(255,255,255,0.7)' : '#0B2A52'}
            font-size="13"
            font-family="Manrope, ui-sans-serif, sans-serif"
            letter-spacing="0.18em"
          >
            <text x="320" y="98" text-anchor="middle">CENTRAL</text>
            <text x="320" y="194" text-anchor="middle">STATE</text>
            <text x="320" y="282" text-anchor="middle">ASSIGNMENT</text>
          </g>
        </g>
      )
    }

    {
      variant === 'project' && (
        <g>
          <line x1="64" y1="80" x2="64" y2="300" stroke={isDark ? 'rgba(255,255,255,0.2)' : '#E5E9E7'} />
          <line x1="64" y1="300" x2="584" y2="300" stroke={isDark ? 'rgba(255,255,255,0.2)' : '#E5E9E7'} />
          <rect x="96" y="120" width="140" height="28" fill="#3F9B2F" opacity="0.85" />
          <rect x="236" y="168" width="180" height="28" fill={isDark ? 'rgba(255,255,255,0.35)' : '#0B2A52'} />
          <rect x="416" y="216" width="140" height="28" fill="#F5B51B" />
          <g
            fill={isDark ? 'rgba(255,255,255,0.6)' : '#64717D'}
            font-size="11"
            font-family="ui-monospace, monospace"
            letter-spacing="0.14em"
          >
            <text x="96" y="108">SUPERVISION</text>
            <text x="236" y="156">ENGINEERING SUPPORT</text>
            <text x="416" y="204">PMC</text>
          </g>
        </g>
      )
    }

    {
      variant === 'renewable' && (
        <g>
          <circle cx="140" cy="110" r="36" stroke="#F5B51B" />
          <path d="M140 74 V48 M140 146 V172 M104 110 H78 M176 110 H202" stroke="#F5B51B" />
          <path d="M300 260 L300 90 L268 150 L332 150 Z" stroke={isDark ? 'rgba(255,255,255,0.7)' : '#0B2A52'} />
          <path d="M300 260 H420 V200 H520" stroke="#3F9B2F" stroke-width="1.5" />
          <rect x="520" y="168" width="56" height="64" stroke={isDark ? 'rgba(255,255,255,0.55)' : '#0B2A52'} />
          <g
            fill={isDark ? 'rgba(255,255,255,0.55)' : '#64717D'}
            font-size="11"
            font-family="ui-monospace, monospace"
            letter-spacing="0.14em"
          >
            <text x="140" y="220" text-anchor="middle">SOLAR</text>
            <text x="300" y="300" text-anchor="middle">WIND</text>
            <text x="548" y="252" text-anchor="middle">GRID</text>
          </g>
        </g>
      )
    }

    {
      variant === 'market' && (
        <g>
          <path
            d="M48 200 C 140 110, 220 260, 320 170 S 500 90, 592 160"
            stroke="#3F9B2F"
            stroke-width="1.5"
          />
          <path
            d="M48 240 C 160 160, 260 280, 360 210 S 520 140, 592 210"
            stroke="#F5B51B"
            stroke-width="1"
            opacity="0.8"
          />
          <circle cx="140" cy="148" r="6" stroke={isDark ? 'rgba(255,255,255,0.6)' : '#0B2A52'} />
          <circle cx="320" cy="170" r="6" stroke={isDark ? 'rgba(255,255,255,0.6)' : '#0B2A52'} />
          <circle cx="500" cy="118" r="6" stroke={isDark ? 'rgba(255,255,255,0.6)' : '#0B2A52'} />
          <g
            fill={isDark ? 'rgba(255,255,255,0.6)' : '#64717D'}
            font-size="11"
            font-family="ui-monospace, monospace"
            letter-spacing="0.14em"
          >
            <text x="140" y="70" text-anchor="middle">OPERATION</text>
            <text x="320" y="70" text-anchor="middle">SCHEDULING</text>
            <text x="500" y="70" text-anchor="middle">DISPATCH</text>
          </g>
        </g>
      )
    }

    {
      variant === 'docs' && (
        <g>
          <rect x="120" y="64" width="280" height="200" stroke={isDark ? 'rgba(255,255,255,0.35)' : '#0B2A52'} />
          <rect x="148" y="88" width="280" height="200" stroke="#3F9B2F" />
          <rect x="176" y="112" width="280" height="200" stroke="#F5B51B" />
          <path
            d="M200 160 H420 M200 188 H380 M200 216 H400 M200 244 H340"
            stroke={isDark ? 'rgba(255,255,255,0.35)' : '#E5E9E7'}
          />
          <g
            fill={isDark ? 'rgba(255,255,255,0.65)' : '#0B2A52'}
            font-size="12"
            font-family="Manrope, ui-sans-serif, sans-serif"
            letter-spacing="0.16em"
          >
            <text x="316" y="148" text-anchor="middle">DPR / PROPOSAL</text>
          </g>
        </g>
      )
    }

    {
      variant === 'audit' && (
        <g>
          <circle cx="320" cy="180" r="96" stroke={isDark ? 'rgba(255,255,255,0.3)' : '#0B2A52'} />
          <path d="M320 84 V48 M320 276 V312 M224 180 H188 M416 180 H452" stroke="#3F9B2F" />
          <path d="M278 180 H362 M320 138 V222" stroke={isDark ? 'rgba(255,255,255,0.7)' : '#0B2A52'} />
          <path d="M292 176 L314 198 L360 148" stroke="#F5B51B" stroke-width="2" />
          <g
            fill={isDark ? 'rgba(255,255,255,0.55)' : '#64717D'}
            font-size="11"
            font-family="ui-monospace, monospace"
            letter-spacing="0.14em"
          >
            <text x="320" y="340" text-anchor="middle">AUDIT</text>
          </g>
        </g>
      )
    }
  </svg>
  {
    caption && (
      <figcaption class:list={['mt-3 text-xs tracking-wide', isDark ? 'text-white/65' : 'text-mute']}>
        {caption}
      </figcaption>
    )
  }
</figure>
