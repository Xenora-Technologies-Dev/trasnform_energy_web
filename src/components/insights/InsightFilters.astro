---
import { listingFilters, getCategory } from '@/data/energy-news-config';

const filters = listingFilters.map((id) => getCategory(id)).filter(Boolean);
---

<div class="border border-line bg-white p-4 sm:p-5" data-insight-toolbar>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="min-w-0 flex-1">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-energy">Filter</p>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter insights">
        <button
          type="button"
          class="border border-navy bg-navy px-3 py-1.5 text-xs font-semibold tracking-wide text-white"
          data-insight-filter="all"
          aria-pressed="true"
        >
          All
        </button>
        {
          filters.map((filter) => (
            <button
              type="button"
              class="border border-line bg-white px-3 py-1.5 text-xs font-semibold tracking-wide text-navy hover:border-navy/40"
              data-insight-filter={filter!.id}
              aria-pressed="false"
            >
              {filter!.filterLabel}
            </button>
          ))
        }
      </div>
    </div>
    <label class="block w-full max-w-sm">
      <span class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-energy">Search</span>
      <input
        type="search"
        data-insight-search
        placeholder="Search titles, sources and topics"
        class="mt-3 w-full border border-line bg-canvas px-3 py-2 text-sm text-ink placeholder:text-mute focus:border-navy focus:outline-none"
      />
    </label>
  </div>
  <p class="mt-4 hidden text-sm text-mute" data-insight-empty>
    No matching briefings. Try another topic or clear the search.
  </p>
  <button
    type="button"
    class="mt-4 hidden border border-navy px-4 py-2 text-sm font-semibold text-navy hover:bg-canvas"
    data-insight-more
  >
    Load more
  </button>
</div>

<script>
  import { ENERGY_NEWS_CONFIG } from '@/data/energy-news-config';

  function initInsightListing() {
    const items = [...document.querySelectorAll<HTMLElement>('[data-insight-item]')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-insight-filter]')];
    const search = document.querySelector<HTMLInputElement>('[data-insight-search]');
    const empty = document.querySelector<HTMLElement>('[data-insight-empty]');
    const more = document.querySelector<HTMLButtonElement>('[data-insight-more]');
    if (items.length === 0) return;

    let active = 'all';
    let query = '';
    let visibleLimit = ENERGY_NEWS_CONFIG.listingPageSize;

    const apply = () => {
      const matched = items.filter((item) => {
        const categories = item.dataset.categories ?? '';
        const region = item.dataset.region ?? '';
        const haystack = (item.dataset.search ?? '').toLowerCase();
        const categoryOk =
          active === 'all' ||
          categories.split(' ').includes(active) ||
          (active === 'kerala-energy' && region === 'kerala') ||
          (active === 'india-energy' && region === 'india') ||
          (active === 'global-energy' && region === 'global');
        const queryOk = !query || haystack.includes(query);
        return categoryOk && queryOk;
      });

      items.forEach((item) => {
        item.hidden = true;
      });
      matched.slice(0, visibleLimit).forEach((item) => {
        item.hidden = false;
      });

      if (empty) empty.classList.toggle('hidden', matched.length > 0);
      if (more) {
        const remaining = matched.length > visibleLimit;
        more.classList.toggle('hidden', !remaining);
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        active = button.dataset.insightFilter ?? 'all';
        visibleLimit = ENERGY_NEWS_CONFIG.listingPageSize;
        buttons.forEach((item) => {
          const on = item === button;
          item.setAttribute('aria-pressed', on ? 'true' : 'false');
          item.classList.toggle('bg-navy', on);
          item.classList.toggle('text-white', on);
          item.classList.toggle('border-navy', on);
          item.classList.toggle('bg-white', !on);
          item.classList.toggle('text-navy', !on);
          item.classList.toggle('border-line', !on);
        });
        apply();
      });
    });

    search?.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      visibleLimit = ENERGY_NEWS_CONFIG.listingPageSize;
      apply();
    });

    more?.addEventListener('click', () => {
      visibleLimit += ENERGY_NEWS_CONFIG.listingPageSize;
      apply();
    });

    apply();
  }

  initInsightListing();
  document.addEventListener('astro:page-load', initInsightListing);
</script>
