---
import { company } from '@/data/company';
import { absoluteUrl } from '@/data/seo';
import {
  insightPath,
  jsonLdType,
  primaryCategory,
  type InsightEntry,
} from '@/lib/insights';

type Props = {
  entry: InsightEntry;
  related?: InsightEntry[];
};

const { entry } = Astro.props;
const origin = Astro.site;
const canonical = origin ? absoluteUrl(insightPath(entry), origin) : insightPath(entry);
const image = origin ? absoluteUrl(`/og/insights/${entry.id}.svg`, origin) : `/og/insights/${entry.id}.svg`;
const logo = origin ? absoluteUrl('/brand/tecs-logo.jpg', origin) : '/brand/tecs-logo.jpg';
const category = primaryCategory(entry);

const article = {
  '@context': 'https://schema.org',
  '@type': jsonLdType(entry),
  headline: entry.data.title,
  description: entry.data.description,
  image,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  author: {
    '@type': 'Organization',
    name: company.publicName,
    url: origin ? new URL('/', origin).toString() : undefined,
  },
  publisher: {
    '@type': 'Organization',
    name: company.publicName,
    logo: {
      '@type': 'ImageObject',
      url: logo,
    },
  },
  isBasedOn: entry.data.originalUrl,
  articleSection: category?.label,
};

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: origin ? new URL('/', origin).toString() : '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Insights',
      item: origin ? absoluteUrl('/insights', origin) : '/insights',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: canonical,
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(article)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
