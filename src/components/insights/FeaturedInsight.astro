---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import EditorialFallback from '@/components/insights/EditorialFallback.astro';
import type { InsightEntry } from '@/lib/insights';
import { formatInsightDate, insightPath, primaryCategory } from '@/lib/insights';

type Props = {
  entry: InsightEntry;
};

const { entry } = Astro.props;
const category = primaryCategory(entry);
---

<article class="overflow-hidden border border-line bg-white" data-insight-item data-categories={entry.data.categories.join(' ')} data-region={entry.data.region} data-search={[entry.data.title, entry.data.description, ...entry.data.categories, ...entry.data.tags, entry.data.sourceName].join(' ')}>
  <a href={insightPath(entry)} class="block">
    <EditorialFallback category={category?.label ?? 'Insights'} title={entry.data.title} compact />
  </a>
  <div class="p-7 sm:p-10 lg:p-12">
    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">Featured</p>
    <p class="mt-3 text-xs text-mute">
      {category?.label}
      <span aria-hidden="true"> · </span>
      <time datetime={entry.data.pubDate.toISOString()}>Published {formatInsightDate(entry.data.pubDate)}</time>
    </p>
    <h2 class="mt-4 max-w-4xl text-3xl font-semibold tracking-tight text-navy sm:text-4xl lg:text-[2.75rem] lg:leading-tight">
      <a href={insightPath(entry)} class="hover:underline">{entry.data.title}</a>
    </h2>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-mute sm:text-lg">{entry.data.summary}</p>
    <a href={insightPath(entry)} class="mt-8 inline-flex items-center gap-1 text-sm font-semibold text-navy">
      Read the briefing
      <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</article>
