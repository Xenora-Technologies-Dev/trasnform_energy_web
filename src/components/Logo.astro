---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/tecs-logo.jpg';
import { company } from '@/data/company';

type Props = {
  size?: 'header' | 'compact' | 'footer' | 'hero' | 'contact';
  linked?: boolean;
  showName?: boolean;
  class?: string;
};

const { size = 'header', linked = true, showName = false, class: className = '' } = Astro.props;

const sizes = {
  header: { height: 72, widths: [144, 216, 288], className: 'h-16 w-auto md:h-[4.5rem]' },
  compact: { height: 56, widths: [112, 168, 224], className: 'h-14 w-auto' },
  footer: { height: 88, widths: [176, 264, 352], className: 'h-[5.5rem] w-auto md:h-24' },
  hero: { height: 280, widths: [280, 420, 560], className: 'h-[13.5rem] w-auto sm:h-64 lg:h-[18.5rem]' },
  contact: { height: 200, widths: [200, 300, 400], className: 'h-44 w-auto md:h-52' },
} as const;

const current = sizes[size];
const onDark = size === 'footer';
const width = Math.round((logo.width / logo.height) * current.height);
const Tag = linked ? 'a' : 'div';
---

<Tag
  {...(linked ? { href: '/', 'aria-label': `${company.publicName} home` } : {})}
  class:list={[
    'brand-logo-link inline-flex items-center',
    showName ? 'min-w-0 gap-2 sm:gap-3' : 'shrink-0 justify-center',
    onDark && 'rounded-sm bg-white p-2 md:p-2.5',
    className,
  ]}
>
  <Image
    src={logo}
    alt={showName ? '' : `${company.legalName} official logo`}
    width={width}
    height={current.height}
    widths={[...current.widths]}
    sizes={`${current.height}px`}
    format="jpg"
    quality={90}
    class:list={['brand-logo h-auto max-w-none shrink-0 object-contain', current.className]}
    loading={size === 'header' || size === 'hero' ? 'eager' : 'lazy'}
    decoding={size === 'header' || size === 'hero' ? 'sync' : 'async'}
  />
  {
    showName && (
      <span class="brand-wordmark min-w-0">
        <span class="block whitespace-nowrap text-[0.62rem] font-semibold uppercase leading-[1.2] tracking-[0.06em] text-navy sm:text-[0.7rem] sm:tracking-[0.08em] md:text-xs">
          Transform Energy
        </span>
        <span class="mt-0.5 block whitespace-nowrap text-[0.62rem] font-semibold uppercase leading-[1.2] tracking-[0.06em] text-navy sm:text-[0.7rem] sm:tracking-[0.08em] md:text-xs">
          Consultancy Services LLP
        </span>
      </span>
    )
  }
</Tag>
