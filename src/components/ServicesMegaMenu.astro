---
import { services } from '@/data/services';

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;

const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<div
  hidden
  id="services-menu"
  data-services-panel
  class="invisible absolute inset-x-0 top-full z-50 border-b border-line bg-white opacity-0 shadow-[0_16px_40px_rgba(7,27,53,0.08)] transition-opacity duration-150"
  role="region"
  aria-label="Services"
>
  <div class="mx-auto grid shell gap-0 lg:grid-cols-[minmax(0,16rem)_1fr]">
    <div class="border-b border-line bg-canvas px-6 py-6 sm:px-8 lg:border-b-0 lg:border-r">
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-mute">Services</p>
      <p class="mt-3 text-sm leading-relaxed text-ink/80">
        Electrical engineering, regulation, project support, renewables, markets, documentation, and
        safety audit.
      </p>
      <a
        href="/services"
        class="mt-5 inline-block text-sm font-semibold text-navy hover:underline"
        data-services-all
      >
        View all services
      </a>
    </div>
    <ul class="grid sm:grid-cols-2">
      {
        services.map((service, index) => (
          <li class="border-b border-line sm:odd:border-r">
            <a
              href={service.href}
              class:list={[
                'flex gap-3 px-5 py-4 transition-colors hover:bg-canvas focus-visible:bg-canvas',
                isCurrent(service.href) && 'bg-canvas',
              ]}
              aria-current={isCurrent(service.href) ? 'page' : undefined}
            >
              <span class="font-mono text-[0.65rem] tracking-[0.16em] text-mute">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                <span class="block text-sm font-semibold text-navy">{service.menuLabel}</span>
                <span class="mt-1 block text-xs leading-relaxed text-mute">{service.summary}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
