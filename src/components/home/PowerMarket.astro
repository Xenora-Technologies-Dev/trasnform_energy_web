---
import AnimatedReveal from '@/components/AnimatedReveal.astro';
import Button from '@/components/Button.astro';
---

<section id="power-market" class="scroll-mt-28 overflow-hidden bg-navy-dark text-white">
  <div class="mx-auto grid shell items-stretch lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <div class="flex flex-col justify-center px-6 py-16 sm:px-8 lg:py-24">
      <AnimatedReveal>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-spark">
          Specialised capability
        </p>
        <h2 class="mt-3 max-w-lg text-3xl font-semibold tracking-tight sm:text-4xl lg:text-[2.6rem] lg:leading-tight">
          Power Market Operations &amp; Scheduling
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-white/75 sm:text-lg">
          Technical advisory on power market operation, scheduling, and dispatch — the operational
          layer between infrastructure, regulation, and day-to-day system requirements.
        </p>
        <div class="mt-8">
          <Button href="/services/power-market" variant="outline-on-dark">
            Learn more
          </Button>
        </div>
      </AnimatedReveal>
    </div>

    <div class="relative min-h-[22rem] overflow-hidden border-t border-white/10 lg:border-l lg:border-t-0">
      <div
        class="pointer-events-none absolute inset-0 opacity-40"
        style="background-image: linear-gradient(to right, rgba(255,255,255,0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 48px 48px;"
        aria-hidden="true"
      >
      </div>
      <figure class="relative h-full min-h-[22rem] px-6 py-10 sm:px-8 lg:py-12">
        <svg
          class="h-full w-full"
          viewBox="0 0 1200 280"
          fill="none"
          role="img"
          aria-labelledby="market-diagram-title market-diagram-desc"
        >
          <title id="market-diagram-title">Illustrative operating sequence</title>
          <desc id="market-diagram-desc">
            Schematic of power-market advisory covering operation, scheduling, and dispatch. Not market data.
          </desc>
          <path
            d="M40 150 C 180 80, 320 220, 480 140 S 780 60, 920 130 S 1080 190, 1160 110"
            stroke="rgba(63,155,47,0.85)"
            stroke-width="1.5"
          />
          <path
            d="M40 190 C 200 120, 360 240, 540 170 S 820 100, 1160 160"
            stroke="rgba(245,181,27,0.55)"
            stroke-width="1"
          />
          <circle class="market-pulse" cx="480" cy="140" r="4" fill="#F5B51B" />
          <g fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1">
            <circle cx="180" cy="118" r="6" />
            <circle cx="480" cy="140" r="6" />
            <circle cx="780" cy="92" r="6" />
            <circle cx="1080" cy="148" r="6" />
          </g>
          <g fill="#F8FAF9" font-size="13" font-family="Manrope, ui-sans-serif, sans-serif" letter-spacing="0.16em">
            <text x="180" y="52" text-anchor="middle">OPERATION</text>
            <text x="480" y="52" text-anchor="middle">SCHEDULING</text>
            <text x="780" y="52" text-anchor="middle">DISPATCH</text>
            <text x="1080" y="52" text-anchor="middle">SYSTEM</text>
          </g>
          <g fill="rgba(255,255,255,0.45)" font-size="11" font-family="ui-monospace, monospace">
            <text x="40" y="248">T0</text>
            <text x="400" y="248">T1</text>
            <text x="760" y="248">T2</text>
            <text x="1128" y="248">Tn</text>
          </g>
          <line x1="40" y1="230" x2="1160" y2="230" stroke="rgba(255,255,255,0.18)" />
        </svg>
        <figcaption class="mt-2 text-xs tracking-wide text-white/65">
          Illustrative operating sequence — not market data.
        </figcaption>
      </figure>
    </div>
  </div>
</section>
