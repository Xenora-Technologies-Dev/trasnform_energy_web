---
import AnimatedReveal from '@/components/AnimatedReveal.astro';
import { experienceDomains } from '@/data/homepage';
---

<section id="experience" class="scroll-mt-28 border-b border-line bg-white">
  <div class="mx-auto shell px-6 py-16 sm:px-8 lg:py-20 xl:px-12">
    <AnimatedReveal>
      <div class="grid items-end gap-8 border-b border-line pb-10 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-16 xl:grid-cols-[minmax(0,28rem)_1fr] xl:gap-24">
        <div>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">
            Leadership
          </p>
          <p
            class="mt-3 flex items-baseline gap-1 text-6xl font-semibold tracking-tight text-navy sm:text-7xl"
            aria-label="More than 30 years of leadership experience"
          >
            <span class="tabular-nums">30</span>
            <span class="text-energy">+</span>
          </p>
        </div>
        <div class="max-w-2xl xl:max-w-3xl">
          <h2 class="text-3xl font-semibold tracking-tight text-navy sm:text-4xl">
            Years of Leadership Experience
          </h2>
          <p class="mt-4 text-base leading-relaxed text-mute sm:text-lg">
            The leadership team brings over three decades of experience across the power and energy
            sector. That figure describes the people, not the age of the firm — former directors,
            chief engineers, and inspectors from Kerala’s power sector.
          </p>
        </div>
      </div>
    </AnimatedReveal>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 xl:gap-10">
      {
        experienceDomains.map((domain, index) => (
          <li>
            <AnimatedReveal>
              <p class="font-mono text-[0.65rem] tracking-[0.18em] text-mute">
                {String(index + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-3 text-lg font-semibold text-navy">{domain.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mute">{domain.body}</p>
            </AnimatedReveal>
          </li>
        ))
      }
    </ul>
  </div>
</section>
