---
import AnimatedReveal from '@/components/AnimatedReveal.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Photo from '@/components/Photo.astro';
import { company } from '@/data/company';
import { photos } from '@/data/photos';
---

<section id="about" class="scroll-mt-28 bg-canvas">
  <div class="mx-auto grid shell items-start gap-12 px-6 py-16 sm:px-8 lg:grid-cols-2 lg:gap-16 lg:py-24 xl:gap-20 xl:px-12">
    <AnimatedReveal>
      <SectionHeading
        eyebrow="About Transform Energy"
        title="Who we are"
      />
      <div class="mt-6 max-w-xl space-y-4 text-base leading-relaxed text-mute sm:text-lg xl:max-w-2xl">
        {company.whoWeAre.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <div>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">Vision</p>
          <p class="mt-3 text-base font-semibold leading-snug text-navy sm:text-lg">{company.vision}</p>
        </div>
        <div>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">Mission</p>
          <p class="mt-3 text-sm leading-relaxed text-mute sm:text-base">{company.mission}</p>
        </div>
      </div>
    </AnimatedReveal>
    <AnimatedReveal>
      <Photo
        src={photos.engineering}
        alt="Engineering review in a technical workspace"
        class="overflow-hidden border border-line bg-white"
        imgClass="h-[20rem] w-full object-cover sm:h-[24rem] lg:h-[28rem] xl:h-[32rem]"
        sizes="(min-width: 1536px) 720px, (min-width: 1024px) 560px, 100vw"
      />
    </AnimatedReveal>
  </div>
</section>
