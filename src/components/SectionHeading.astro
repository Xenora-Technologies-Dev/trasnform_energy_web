---
type Props = {
  eyebrow?: string;
  title: string;
  kicker?: string;
  align?: 'left' | 'center';
};

const { eyebrow, title, kicker, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {
    eyebrow && (
      <p class="mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-energy">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-3xl font-semibold tracking-tight text-navy sm:text-4xl lg:text-[2.75rem] lg:leading-tight">
    {title}
  </h2>
  {
    kicker && (
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-mute sm:text-lg">{kicker}</p>
    )
  }
</div>
